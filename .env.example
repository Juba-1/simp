# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/simp_platform?schema=public"

# JWT
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# CORS (comma-separated; dev mode also accepts any origin via main.ts)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=1
TIME_SPOOFING_THRESHOLD_MS=300000

# SLA
EXTERNAL_SLA_HOURS=48
SLA_CRON_EXPRESSION=0 * * * *

# Supabase Storage (avatars)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AVATARS_BUCKET=avatars
